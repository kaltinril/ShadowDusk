<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Dependabot (.github/dependabot.yml) opens weekly bump PRs for this file. A DELIBERATE pin
       (native hashes, a render-proof runtime, an evidence pin) and any package a shipped src/
       project references also need an `ignore:` entry there, or Dependabot keeps proposing the
       bump. Rules: project_rules.md, "Dependabot PRs meet the same bar". -->

  <!-- Vortice.Direct3D12 is deliberately ABSENT (dropped in Phase 63, issue #203): it carries one
       type the CLR refuses to load, and MonoGame 3.8.5's Content Builder GetTypes()-scans every
       consumer dependency unguarded. The ID3D12ShaderReflection interop is ShadowDusk-owned now. -->
  <ItemGroup Label="DXC">
    <!-- EXACT range (issue #270): DxcLoader runs only the DXC natives Vortice.Dxc 3.3.4 ships
         (DxcNativeIdentity pins them) and refuses any other build with SD0219. The packed
         nuspec then says [3.3.4], so a consumer graph that lifts Vortice.Dxc (e.g. through
         another engine's package) gets NuGet's NU1608 at restore, not only SD0219 at run time. -->
    <PackageVersion Include="Vortice.Dxc" Version="[3.3.4]" />
  </ItemGroup>

  <ItemGroup Label="D3DCompiler (DXBC oracle backend — managed wrapper restores cross-platform; runtime is Windows-only, guarded by OperatingSystem.IsWindows())">
    <PackageVersion Include="Vortice.D3DCompiler" Version="3.3.4" />
    <PackageVersion Include="Vortice.Direct3D11" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup Label="SPIRV-Cross">
    <!-- Issue #350: SpvcLoader loads only these exact natives (SpvcLoader.Sha256ByRid, the SHA-256
         of each runtimes/<rid>/native file). A bump must re-pin those hashes (SpvcLoaderPinTests
         fails until it does) and the Android build's SPIRV-Cross commit. -->
    <PackageVersion Include="Silk.NET.SPIRV.Cross.Native" Version="2.23.0" />
  </ItemGroup>

  <!--
    SixLabors.ImageSharp is GONE and must not come back (project_decisions.md, "Own PNG code
    instead of ImageSharp"). Every release that fixes its October 2026 security advisories
    (3.2.0, 4.1.2+) refuses to build without a paid Six Labors licence, and every release that
    builds without one carries those advisories. PNG read/write for the tests and validation
    tooling is tests/ShadowDusk.TestPng instead. Same class of problem as the FluentAssertions
    relicensing that drove the Shouldly migration below - a licence gate, not a technical one.
  -->
  <ItemGroup Label="Rendering">
    <PackageVersion Include="Silk.NET.OpenGL"          Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Windowing.Glfw"  Version="2.23.0" />
    <!-- Phase 62 (issue #197): TEST-ONLY dependency, never a product one - the SkSL converter's
         evidence bar is "Skia's own compiler accepts the emission and it renders right", and
         SKRuntimeEffect is how a test asks Skia. The Linux native package keeps the CI ubuntu
         lanes loading libSkiaSharp. -->
    <PackageVersion Include="SkiaSharp"                                    Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies"  Version="4.151.1" />
  </ItemGroup>

  <ItemGroup Label="MonoGame runtime validation (Phase 17 / Phase 18)">
    <PackageVersion Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
    <PackageVersion Include="MonoGame.Framework.WindowsDX" Version="3.8.2.1105" />
  </ItemGroup>

  <!-- Validation-only, never a product dependency: the KNI EffectTest gate
       (validation/KniEffectTest{KniGl,KniDx}). 4.2.9001 is the KNI line every other KNI harness
       pins; the drivers also build against 4.3.9001 with -p:KniVersion=4.3.9001 (a VersionOverride,
       with its own lock file). Older KNI harnesses keep their local pins (they opt out of central
       management); these entries only apply to projects that reference them without a version. -->
  <ItemGroup Label="KNI runtime validation (KniEffectTest gate)">
    <PackageVersion Include="nkast.Xna.Framework"              Version="4.2.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Content"      Version="4.2.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Graphics"     Version="4.2.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Audio"        Version="4.2.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Media"        Version="4.2.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Input"        Version="4.2.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Game"         Version="4.2.9001" />
    <PackageVersion Include="nkast.Kni.Platform.SDL2.GL"       Version="4.2.9001" />
    <PackageVersion Include="nkast.Kni.Platform.WinForms.DX11" Version="4.2.9001" />
  </ItemGroup>

  <!-- Validation-only: MonoGame 3.8.5's native-runtime packages (WindowsDX12, DesktopVK), for the
       KNI EffectTest gate's DX12 and Vulkan drivers. The older 3.8.5 harnesses keep local pins. -->
  <ItemGroup Label="MonoGame 3.8.5 native runtimes (KniEffectTest gate)">
    <PackageVersion Include="MonoGame.Framework.Native"       Version="3.8.5" />
    <PackageVersion Include="MonoGame.Runtime.Windows.DX12"   Version="3.8.5" />
    <PackageVersion Include="MonoGame.Runtime.Windows.Vulkan" Version="3.8.5" />
    <PackageVersion Include="MonoGame.Runtime.Linux.Vulkan"   Version="3.8.5" />
  </ItemGroup>

  <!-- Phase 59: validation-only, never a product dependency. validation/RaylibRoute renders the
       raylib converter's output in real Raylib-cs (raylib 6.0, glsl330). Pinned because the
       render gate's evidence is only as good as the runtime it ran against. -->
  <ItemGroup Label="Raylib runtime validation (Phase 59)">
    <PackageVersion Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <!--
    Phase 29: the MGCB content-processor plugin's BUILD-TIME contract assembly
    (ContentImporter/ContentProcessor/EffectContent/CompiledEffectContent). This is a
    compile-only reference: ShadowDusk.MgcbPlugin sets ExcludeAssets="runtime" so the
    plugin never carries its own copy - MGCB's own process already has one loaded, and a
    second copy in the plugin directory is how you get two incompatible CompiledEffectContent
    types and a "no ContentTypeWriter found" build failure.

    3.8.2.1105 is deliberate, and it is a FLOOR, not a pin to "the" MonoGame version: the
    ContentImporter/ContentProcessor TYPE contract has been stable across 3.8.x, so a plugin
    compiled against the oldest supported contract loads into every newer MGCB (and binds
    inside a 3.8.5 Content Builder). Compiling against a NEWER one would not load into an
    older MGCB. Verified in-process against dotnet mgcb 3.8.2.1105, 3.8.4.1, and 3.8.5.
    The enum NUMBERING is NOT stable: 3.8.5 renumbered TargetPlatform (Web=12, DesktopVK=13,
    WindowsDX12=14, XboxSeries=15), so MgcbPlatformMap keys on names, never members
    (Phase 63 Area B). ShadowDusk.ContentPipeline (the library shape for the 3.8.5 Content
    Builder) shares this same floor as a REAL dependency.
  -->
  <ItemGroup Label="MGCB plugin contract (Phase 29)">
    <PackageVersion Include="MonoGame.Framework.Content.Pipeline" Version="3.8.2.1105" />
  </ItemGroup>

  <!--
    Apos.Shapes is an EVIDENCE PIN, not a currency pin - do not bump it as part of a routine
    dependency sweep. Phase 55 uses the package's own embedded effect as the gallery baseline
    arm, which is only a valid comparison because the package's shader IS our vendored
    tests/fixtures/shaders/third-party/Apos.Shapes/apos-shapes-sm6.fx.

    0.7.7 pins upstream commit a85a31c, which matches that fixture modulo one comment line.
    Checked 2026-07-28: 0.7.12 pins a DIFFERENT commit (b69bd73) whose apos-shapes.fx differs by
    ~1150 lines and adds a FOURTH sampler - a new `ArcTex` at register t2 that pushes
    `BlueNoiseTex` to t3. Bumping therefore silently points the baseline arm at a different
    shader than the candidate. Moving this pin means vendoring the new upstream revision and
    re-running the whole Phase 55 proof; it is that phase's work, not a version bump.
  -->
  <ItemGroup Label="Apos.Shapes (Phase 55 - real ShapeBatch gallery render-proof)">
    <PackageVersion Include="Apos.Shapes" Version="0.7.7" />
  </ItemGroup>

  <!--
    Test-only. None of these reach a consumer: the shipped src/ projects reference exactly
    Silk.NET.SPIRV.Cross.Native and Vortice.*, nothing here.

    ASSERTION LIBRARY: Shouldly, and FluentAssertions is BANNED (issue #171).

    FluentAssertions relicensed at 8.x to the Xceed "Community License Agreement (for
    Non-Commercial Use)", which requires a PAID commercial licence for any use by an
    organisation that earns revenue. We previously capped it at 7.2.2, the last Apache-2.0
    release - but a cap only defers the problem: the 7.x line receives no further fixes, so
    the choice was "migrate now" or "migrate later from a frozen, unmaintained dependency".
    We migrated. Shouldly is BSD-3-Clause at every version, with no commercial gate.

    Do not re-add FluentAssertions - not at 7.x, not "just for one test". Shouldly's entry
    points are ShouldBe/ShouldContain/... on the value itself, never .Should().
    See project_facts.md and project_decisions.md for the full rationale.
  -->
  <ItemGroup Label="Test">
    <PackageVersion Include="xunit"                        Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio"    Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk"       Version="18.8.1" />
    <PackageVersion Include="Shouldly"                     Version="4.3.0" />
    <PackageVersion Include="coverlet.collector"           Version="10.0.1" />
  </ItemGroup>
</Project>
