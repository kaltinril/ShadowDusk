<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 54 - DirectX12 VS-driven + Apos.Shapes render-proof, the DX12 analogue of
       VsDrivenDx / VsDrivenVulkan. Windows-only: MonoGame.Runtime.Windows.DX12 is a
       DX12 (Windows) native runtime. Intentionally NOT in ShadowDusk.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>ShadowDusk.Validation.Dx12.VsDriven</RootNamespace>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <MonoGamePlatform>WindowsDX12</MonoGamePlatform>
  </PropertyGroup>

  <ItemGroup Label="MonoGame 3.8.5 stable WindowsDX12">
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.5" />
    <PackageReference Include="MonoGame.Runtime.Windows.DX12" Version="3.8.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShadowDusk.Compiler\ShadowDusk.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SharedDx\DxEffectImageRenderer.cs" />
    <Compile Include="..\SharedDx\VsDxEffectImageRenderer.cs" />
  </ItemGroup>

</Project>
