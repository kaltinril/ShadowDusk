<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Issue #145 - VS-DRIVEN Vulkan render gate. The Vulkan proof before this was
    validation/CandidateVulkan: 10 PS-only, matrix-free shaders, so no ShadowDusk-produced
    VERTEX shader had ever rendered on a real DesktopVK device. That gap is exactly why the
    row-major matrix bug (every VS-driven Vulkan effect rendered nothing) shipped unnoticed.

    Same DesktopVK package set as BaselineVulkan/CandidateVulkan.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>ShadowDusk.Validation.VsDrivenVulkan</RootNamespace>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <MonoGamePlatform>DesktopVK</MonoGamePlatform>
  </PropertyGroup>

  <ItemGroup Label="MonoGame 3.8.5 stable DesktopVK">
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.5" />
    <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" Version="3.8.5" />
    <!-- Linux natives (libmgruntime.so): the same driver runs in CI on Mesa lavapipe. -->
    <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" Version="3.8.5" />
  </ItemGroup>

  <ItemGroup Label="Apos.Shapes (Phase 55 - real ShapeBatch gallery render-proof)">
    <PackageReference Include="Apos.Shapes" Version="0.7.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShadowDusk.Compiler\ShadowDusk.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" />
    <Compile Include="..\SharedDx\AposGalleryRenderer.cs" />
    <!-- Issue #324 (mode texarr): the MGFX parameter-block reader and the Vulkan ShaderCode
         header reader, source-linked (BCL-only) so the driver can read the mgfxc golden's
         (empty) table and descriptor layout. -->
    <Compile Include="..\..\tests\ShadowDusk.Integration.Tests\MgfxBlobReader.cs" Link="MgfxBlobReader.cs" />
    <Compile Include="..\..\tests\ShadowDusk.Integration.Tests\VulkanShaderCodeReader.cs" Link="VulkanShaderCodeReader.cs" />
  </ItemGroup>

</Project>
