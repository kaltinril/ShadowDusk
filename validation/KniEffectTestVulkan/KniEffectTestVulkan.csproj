<Project Sdk="Microsoft.NET.Sdk">

  <!-- KNI EffectTest gate on real MonoGame 3.8.5 DesktopVK (MGFX v11), vs the committed mgfxc 3.8.5 Vulkan builds. Runs on a GPU and on Mesa lavapipe.
       Not in ShadowDusk.slnx. See validation/SharedKniEffectTest and docs/validation-matrix.md section 6. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>ShadowDusk.Validation.KniEffectTest.Vulkan</RootNamespace>
    <MonoGamePlatform>DesktopVK</MonoGamePlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" />
    <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" />
    <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShadowDusk.Compiler\ShadowDusk.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SharedKniEffectTest\*.cs" />
  </ItemGroup>

  <Import Project="..\MonoGameVersion.targets" />

</Project>
