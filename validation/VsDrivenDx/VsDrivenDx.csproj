<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows-only: MonoGame.Framework.WindowsDX is a DX11 (Windows) runtime.
         Intentionally NOT in ShadowDusk.slnx so cross-platform builds never see it. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>ShadowDusk.Validation.Dx.VsDriven</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" />
    <PackageReference Include="Apos.Shapes" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ShadowDusk.Compiler\ShadowDusk.Compiler.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedDx\DxEffectImageRenderer.cs" />
    <Compile Include="..\SharedDx\VsDxEffectImageRenderer.cs" />
    <Compile Include="..\SharedDx\AposGalleryRenderer.cs" />
    <!-- Issue #254: SHADOWDUSK_DX_WARP=1 pins the device to WARP on the GPU-less CI lane. -->
    <Compile Include="..\SharedDx\DxHeadlessRasterizer.cs" />
    <!-- Issues #339/#340 (modes texarr, samparr): the MGFX parameter-block reader, source-linked
         (BCL-only) so the driver compares the candidate's table with the mgfxc golden's record for
         record, the same way the in-suite tests do. -->
    <Compile Include="..\..\tests\ShadowDusk.Integration.Tests\MgfxBlobReader.cs" Link="MgfxBlobReader.cs" />
  </ItemGroup>
</Project>
