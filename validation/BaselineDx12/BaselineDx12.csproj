<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 54 - DirectX12 oracle side: loads the REAL mgfxc DirectX_12 goldens
       (tests/fixtures/golden/DirectX_12/*.mgfx, produced by real MonoGame 3.8.5
       WindowsDX12 content build, /Platform:WindowsDX12) into a real MonoGame
       WindowsDX12 Effect. Windows-only. Intentionally NOT in ShadowDusk.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>ShadowDusk.Validation.BaselineDx12</RootNamespace>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <MonoGamePlatform>WindowsDX12</MonoGamePlatform>
  </PropertyGroup>

  <ItemGroup Label="MonoGame 3.8.5 stable WindowsDX12">
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.5" />
    <PackageReference Include="MonoGame.Runtime.Windows.DX12" Version="3.8.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" />
  </ItemGroup>

</Project>
