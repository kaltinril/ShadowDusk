<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Clears the single-TFM default from Directory.Build.props: when TargetFramework is
         non-empty MSBuild single-targets and ignores TargetFrameworks entirely. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ShadowDusk.ImageTests</AssemblyName>
    <RootNamespace>ShadowDusk.ImageTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShadowDusk.Compiler\ShadowDusk.Compiler.csproj" />
    <ProjectReference Include="..\..\src\ShadowDusk.Core\ShadowDusk.Core.csproj" />
    <ProjectReference Include="..\..\src\ShadowDusk.HLSL\ShadowDusk.HLSL.csproj" />
    <ProjectReference Include="..\..\src\ShadowDusk.GLSL\ShadowDusk.GLSL.csproj" />
  </ItemGroup>

  <ItemGroup Label="Shared sources">
    <Compile Include="..\ShadowDusk.Integration.Tests\MgfxBlobReader.cs" Link="MgfxBlobReader.cs" />
  </ItemGroup>

  <ItemGroup Label="Fixtures">
    <None Include="..\..\tests\fixtures\shaders\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Link="fixtures\shaders\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\tests\fixtures\golden\OpenGL\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Link="fixtures\golden\OpenGL\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\tests\fixtures\reference-images\OpenGL\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Link="fixtures\reference-images\OpenGL\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Label="Test framework">
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Issue #345 regression guard. Windows destroys a window when the thread that created
       it exits, and the GL fixture once created its hidden GLFW window on a thread-pool
       thread: when the pool retired that thread (20 s idle by default, reached only under a
       loaded full-solution run), the next wglMakeCurrent failed with "The handle is invalid".
       Retiring idle pool threads after 100 ms makes that intermittent failure happen on every
       run, so the fixture's dedicated owner thread (GlContextFixture) is proven by every
       ImageTests run instead of by luck. -->
  <ItemGroup Label="Thread-pool churn (issue 345)">
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.ThreadTimeoutMs" Value="100" />
  </ItemGroup>

  <ItemGroup Label="Rendering">
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>
</Project>
