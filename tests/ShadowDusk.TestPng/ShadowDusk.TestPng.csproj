<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Minimal dependency-free PNG encoder/decoder for the test and validation tooling ONLY.
    It replaces SixLabors.ImageSharp, whose patched releases (3.2.0+, 4.x) require a paid
    licence to build: see project_decisions.md ("Own PNG code instead of ImageSharp").
    Not shipped: IsPackable=false, and no src/ project may reference it.
  -->
  <PropertyGroup>
    <!-- Clears the single-TFM default from Directory.Build.props: when TargetFramework is
         non-empty MSBuild single-targets and ignores TargetFrameworks entirely. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ShadowDusk.TestPng</AssemblyName>
    <RootNamespace>ShadowDusk.TestPng</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShadowDusk.TestPng.Tests" />
  </ItemGroup>
</Project>
