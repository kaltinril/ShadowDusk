<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Clears the single-TFM default from Directory.Build.props: when TargetFramework is
         non-empty MSBuild single-targets and ignores TargetFrameworks entirely. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ShadowDusk.Integration.Tests</AssemblyName>
    <RootNamespace>ShadowDusk.Integration.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Dxc/DxcConcurrencyProbe.cs supplies Main instead of the test SDK's empty generated one,
         so a test can re-run this assembly as a fresh child process (`dotnet exec`) for a
         race that can only happen once per process. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- Dxc/ProbeLibc.cs calls libc (fork, _exit, setlocale, pthread_atfork) through unmanaged
         function pointers: the forked child must not reach a marshalling stub or the JIT. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShadowDusk.Compiler\ShadowDusk.Compiler.csproj" />
    <ProjectReference Include="..\..\src\ShadowDusk.Core\ShadowDusk.Core.csproj" />
    <!-- Phase 47: the ShaderToy/GLSL -> .fx front-end, for the byte-identity test that proves the
         CLI's .glsl route adds no behavior over Convert + the existing pipeline. -->
    <ProjectReference Include="..\..\src\ShadowDusk.ShaderToy\ShadowDusk.ShaderToy.csproj" />
    <ProjectReference Include="..\..\src\ShadowDusk.HLSL\ShadowDusk.HLSL.csproj" />
    <ProjectReference Include="..\..\src\ShadowDusk.GLSL\ShadowDusk.GLSL.csproj" />
    <!-- Phase 21: reference the CLI so its binary is built alongside the tests.
         CliBinaryFixture then reuses that build output instead of running a slow
         per-run `dotnet publish -c Release` (the dominant, AV/cache-sensitive cost
         behind the 21-minute integration run). ReferenceOutputAssembly=false: we
         only want the CLI built + on disk, not linked into the test assembly. -->
    <ProjectReference Include="..\..\src\ShadowDusk.Cli\ShadowDusk.Cli.csproj"
                      ReferenceOutputAssembly="false" />
    <!-- Phase 29: the MGCB content-processor plugin, for the byte-identity proof that its
         .mgfx output is exactly the CLI's. -->
    <ProjectReference Include="..\..\src\ShadowDusk.MgcbPlugin\ShadowDusk.MgcbPlugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 29: the MGCB contract types the plugin tests drive (EffectContent,
         CompiledEffectContent, ContentProcessorContext). compile;runtime ONLY - the `native`
         asset group is MonoGame's texture/audio processor baggage (FreeImage, Assimp, nvtt,
         ffmpeg, ~100 MB across RIDs) that nothing here touches, and dropping it into an
         already antivirus-scan-sensitive integration output directory would cost real time
         for zero coverage. -->
    <PackageReference Include="MonoGame.Framework.Content.Pipeline" IncludeAssets="compile;runtime" />
    <!-- ContentProcessorContext.TargetProfile is a MonoGame.Framework type (GraphicsProfile),
         but MonoGame.Framework.Content.Pipeline 3.8.2.1105 declares NO dependency on
         MonoGame.Framework - so anything that subclasses ContentProcessorContext has to bring
         it. compile;runtime only, for the same native-baggage reason as above (DesktopGL's
         SDL/OpenAL natives are irrelevant here; nothing creates a GraphicsDevice). -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" IncludeAssets="compile;runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 39: source-link the MojoShader-rule fx_2_0 validator from the unit-test
         project (it depends only on the BCL + ShadowDusk.Core, so it links cleanly).
         One validator, two consumers — the unit tests calibrate it against the fxc
         goldens; the FNA integration tests apply it to real pipeline output. -->
    <Compile Include="..\ShadowDusk.Core.Tests\Fx2\Fx2BinaryValidator.cs" Link="Fx2\Fx2BinaryValidator.cs" />
    <!-- Source-link the CLI's diagnostic formatter (BCL + ShadowDusk.Core only) so the
         DirectPipeline test surface uses the SAME formatter the CLI does. TestHelpers used
         to carry a hand-written copy, which drifted: it never learned the file-scoped
         line-less form, so DirectPipeline assertions mirrored a stderr shape the CLI had
         stopped producing. The Cli ProjectReference stays ReferenceOutputAssembly=false
         (Phase 21) - this links the one file, not the tool.
         LOAD-BEARING: this works only while the Cli assembly is NOT referenced here AND
         MgcbErrorFormatter stays `internal`. Adding an InternalsVisibleTo for this project
         (the natural next step, since ShadowDusk.Core.Tests already has one) makes the
         source-linked copy collide with the imported type: CS0436, which
         Directory.Build.props turns into a build error via TreatWarningsAsErrors. -->
    <Compile Include="..\..\src\ShadowDusk.Cli\MgcbErrorFormatter.cs" Link="Cli\MgcbErrorFormatter.cs" />
    <!-- Issue #304 follow-up: the SAME probe the Android harness runs on the device, so the desktop
         and the device hash the OpenGL corpus's SPIR-V, GLSL and .mgfx identically. -->
    <Compile Include="..\..\validation\AndroidGl\OpenGlCorpusProbe.cs" Link="Tests\OpenGlCorpusProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tests\fixtures\shaders\**\*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\shaders\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Issue-reproduction fixtures (tests/fixtures/issues/<n>/): diagnostic-LOCATION fixtures
         that must NOT join the corpus sweeps under fixtures/shaders (issue #202's 3235-line
         Apos.Shapes copy would otherwise enter the GL/DX/Vulkan structural matrices). -->
    <None Include="..\..\tests\fixtures\issues\**\*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\issues\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Phase 39: the fxc fx_2_0 goldens (sources + binaries) for the FNA structural
         cross-check (FnaCompileFixtureTests). -->
    <None Include="..\..\tests\fixtures\golden\FNA\**\*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\golden\FNA\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The legacy-sampler effect-parameter NAME fixtures and their mgfxc 3.8.4.1 goldens
         (LegacySamplerParameterNameTests). Kept out of fixtures/shaders so they do not join
         the corpus sweeps. -->
    <None Include="..\..\tests\fixtures\golden\legacy-sampler-names\**\*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\golden\legacy-sampler-names\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Legacy/modern sampler UNIT (OpenGL) and SLOT (DirectX 11) fixtures and their mgfxc
         3.8.4.1 goldens (LegacySamplerUnitTests), likewise outside the corpus sweeps. -->
    <None Include="..\..\tests\fixtures\golden\legacy-sampler-units\**\*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\golden\legacy-sampler-units\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Phase 37 tail (1): the committed cross-host byte-identity manifest
         (CrossHostByteIdentityTests) — win-x64-generated SHA-256s asserted on every OS. -->
    <None Include="..\..\tests\fixtures\golden\byte-identity\**\*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\golden\byte-identity\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Issue #270: a real, WORKING DXC that is not ShadowDusk's pinned build (DXC 1.9.2602.17,
       what Vortice.Dxc 3.8.3 pulls in through Vortice.Dxc.Native 1.0.5), for the SD0219
       "found a different build" case. PackageDownload is NOT a dependency: nothing references
       it, it only puts the package in the NuGet cache; its natives are copied under
       foreign-dxc/ beside the test assembly, never under runtimes/. -->
  <ItemGroup Label="Foreign DXC fixture">
    <PackageDownload Include="Vortice.Dxc.Native" Version="[1.0.5]" />
  </ItemGroup>
  <!-- EnsureTrailingSlash: a custom NUGET_PACKAGES / globalPackagesFolder (e.g. F:\packages)
       yields NuGetPackageRoot WITHOUT a trailing slash, and the plain concatenation then
       globbed "F:\packagesvortice.dxc.native", matched nothing, and the foreign-DXC tests
       failed with "fixture is missing" instead of running. -->
  <PropertyGroup Condition="'$(NuGetPackageRoot)' != ''">
    <ForeignDxcPackageRuntimes>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))vortice.dxc.native/1.0.5/runtimes/</ForeignDxcPackageRuntimes>
  </PropertyGroup>
  <ItemGroup Condition="'$(ForeignDxcPackageRuntimes)' != ''">
    <None Include="$(ForeignDxcPackageRuntimes)*/native/*"
          CopyToOutputDirectory="PreserveNewest"
          Link="foreign-dxc/1.9/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Issue #362: the directory the glob above probed, stamped into the assembly so a
       "DXC 1.9 fixture is missing" failure names where the build looked (ForeignDxc.cs). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ForeignDxcPackageRuntimes</_Parameter1>
      <_Parameter2>$(ForeignDxcPackageRuntimes)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Issues #312/#316: xUnit reports every test that has been running longer than
         longRunningTestSeconds ("[Long Running Test] 'Name', Elapsed: ..."), so a stalled run
         names the tests that were in flight even when no hang dump could be taken. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Label="Test framework">
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
