<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Clears the single-TFM default from Directory.Build.props: when TargetFramework is
         non-empty MSBuild single-targets and ignores TargetFrameworks entirely. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ShadowDusk.Slang.Tests</AssemblyName>
    <RootNamespace>ShadowDusk.Slang.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShadowDusk.Slang\ShadowDusk.Slang.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 66 A4: source-link the MGFX parameter-block reader from
         ShadowDusk.Integration.Tests (BCL-only, no other deps) so the mangling-fix
         round-trip test reads the SAME parameter names a real Effect's reflection would
         see, instead of a second hand-rolled parser drifting from the real one. Mirrors
         Integration.Tests' own source-link of MgcbErrorFormatter.cs/Fx2BinaryValidator.cs
         from other projects (the established pattern for this repo, not a new one). -->
    <Compile Include="..\ShadowDusk.Integration.Tests\MgfxBlobReader.cs" Link="MgfxBlobReader.cs" />
    <!-- Issue #230: the independent MojoShader-rule fx_2_0 parser, so the FNA tests read the
         parameter table and sampler map real FNA binds from, not just the version token. -->
    <Compile Include="..\ShadowDusk.Core.Tests\Fx2\Fx2BinaryValidator.cs" Link="Fx2BinaryValidator.cs" />
    <!-- Issue #316: the ONE child-process helper every test uses (concurrent stdout/stderr
         drain, process-tree kill and captured output on timeout). BCL-only, like the links
         above. HangDiagnostics comes with it: ChildProcess calls it for a pre-kill dump. -->
    <Compile Include="..\ShadowDusk.Integration.Tests\ChildProcess.cs" Link="ChildProcess.cs" />
    <Compile Include="..\ShadowDusk.Integration.Tests\TestBudget.cs" Link="TestBudget.cs" />
    <Compile Include="..\ShadowDusk.Integration.Tests\HangDiagnostics.cs" Link="HangDiagnostics.cs" />
    <!-- Issue #312: the in-process stall hint (thread counts, DxcForkGate state), written once
         a minute after the host has been up for three minutes. BCL-only; reads the gate by
         reflection. -->
    <Compile Include="..\ShadowDusk.Integration.Tests\HostStallHint.cs" Link="HostStallHint.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issues #312/#316: xUnit reports every test that has been running longer than
         longRunningTestSeconds ("[Long Running Test] 'Name', Elapsed: ..."), so a stalled run
         names the tests that were in flight even when no hang dump could be taken. -->
    <Content Include="..\ShadowDusk.Integration.Tests\xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Label="Test framework">
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
