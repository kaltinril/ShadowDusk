<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Pins its own MonoGame versions (it models a CONSUMER's project), so it opts out of
         the repo-root Directory.Packages.props. Without this, restore fails NU1008 and the
         sample cannot be built or run at all. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinned, not floating: a `3.8.*` float would silently resolve to a newer MonoGame
         than the 3.8.2.1105 the whole repo is proven against. -->
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.2.1105" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.2.1105" />
  </ItemGroup>
  <!-- Copy cat image to output -->
  <ItemGroup>
    <Content Include="Content\cat.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy compiled golden shaders to output so the viewer can load them at runtime -->
  <ItemGroup>
    <Content Include="..\..\tests\fixtures\golden\DirectX_11\*.mgfx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Shaders\DirectX_11\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\tests\fixtures\golden\OpenGL\*.mgfx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Shaders\OpenGL\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
    <Message Text="Restoring dotnet tools" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>