<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>MGCBSample</RootNamespace>
    <AssemblyName>MGCBSample</AssemblyName>
    <!-- This sample pins its own MonoGame versions (it demonstrates a CONSUMER's project,
         which has no relationship to ShadowDusk's central package versions), so it opts out
         of the repo-root Directory.Packages.props. Without this, restore fails NU1008 and
         the sample cannot be built or run at all. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.2.1105" />
  </ItemGroup>

</Project>
