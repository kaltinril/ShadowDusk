<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Clears the single-TFM default from Directory.Build.props. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ShadowDusk.SkSL</AssemblyName>
    <RootNamespace>ShadowDusk.SkSL</RootNamespace>
    <!-- Skeleton: not packable until the converter does something useful. When it ships it needs a
         PackageId, README, release.yml entry and a ShaderToy PackageReference-compatible version
         (it reuses ShadowDusk.ShaderToy internals via InternalsVisibleTo, so both must ship at the
         same shared version). -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShadowDusk.ShaderToy\ShadowDusk.ShaderToy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShadowDusk.SkSL.Tests" />
  </ItemGroup>
</Project>
