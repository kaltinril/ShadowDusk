<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Clears the single-TFM default from Directory.Build.props: when TargetFramework is
         non-empty MSBuild single-targets and ignores TargetFrameworks entirely. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ShadowDusk.HLSL</AssemblyName>
    <RootNamespace>ShadowDusk.HLSL</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Published as part of the ShadowDusk.* set. Its Vortice.Dxc dependency
         (the cross-platform DXC native) flows transitively to consumers of
         ShadowDusk.Compiler — this is what makes the in-memory compile work
         with no external tools. -->
    <IsPackable>true</IsPackable>
    <PackageId>ShadowDusk.HLSL</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>ShadowDusk HLSL front-end: FX9 pre-parse, preprocessor, DXC integration (HLSL to SPIR-V/DXIL via Vortice.Dxc), and the vkd3d-shader DXBC backend (HLSL to SM1–5 D3D bytecode for the DirectX and FNA targets; bundles the vkd3d 2.1 natives for win-x64/linux-x64/osx-x64/osx-arm64). Part of the ShadowDusk.Compiler cross-platform MonoGame/KNI/FNA shader compiler.</Description>
    <PackageTags>monogame kni fna hlsl shader compiler dxc vkd3d dxbc spirv</PackageTags>
    <!-- Phase 26: emit the XML doc file for DocFX. CS1591 suppressed during the
         doc-comment transition so the TreatWarningsAsErrors build stays green. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShadowDusk.HLSL.Tests" />
    <!-- ShadowDusk.Compiler: the pipeline names DxcSpirvEntryRedeclarations.ErrorCode (SD0236) when it puts
         the author's entry-point name back into a Vulkan diagnostic, instead of a copied literal. The
         DirectX 11 texture slot check (DxTextureSlotOrder, HlslReadOrder) reads the explicit t registers
         (GlSamplerSlots.ExplicitTextureRegisters), preprocesses the compiled text (FxMacroPreprocessor),
         and warns SD0230 when the view cannot be built, which only matters when the raw pre-parse found a
         legacy sampler (FxParseResult.LegacySamplerTextures). The Vulkan binding rewrite
         (VulkanTextureSamplerBindingRewriter) asks the managed preprocessor which lines an untaken #if
         drops (FxMacroPreprocessor.SkippedLines), so a Sample call in '#if 0' does not decide a texture's
         sampler. All internal, so none of it is public API of the shipped ShadowDusk.HLSL package. -->
    <InternalsVisibleTo Include="ShadowDusk.Compiler" />
    <!-- Phase 19: the WASM/browser JsDxcShaderCompiler reuses DxcFlagBuilder to
         build identical DXC argument lists before handing source+args to the
         host-provided [JSImport] DXC backend. Phase 4.1: WasmVkd3dShaderCompiler
         reuses Vkd3dCompileContract (the shared request->ABI + error mapping). -->
    <InternalsVisibleTo Include="ShadowDusk.Wasm" />
    <!-- Phase 4.1: the vkd3d->WASM byte-identity gate's desktop ground-truth probe
         (tests/ShadowDusk.BrowserTests/Vkd3dCorpusProbe) records the resolved
         profile/target type via the same shared Vkd3dCompileContract. -->
    <InternalsVisibleTo Include="Vkd3dCorpusProbe" />
    <!-- Issue #256: the DXC setlocale probe (DxcConcurrencyProbe) drives the raw native compile
         call and the result accessors one step at a time, to prove which ones reach DXC's
         setlocale and so must sit inside DxcForkGate. -->
    <InternalsVisibleTo Include="ShadowDusk.Integration.Tests" />
    <!-- KniDirectXProfileTests sweeps FxPreParser.KnownProfileNames, the whole recognized set. -->
    <InternalsVisibleTo Include="ShadowDusk.Compiler.Tests" />
    <!-- Issue #478: validation/ManagedDxilDx12 signs a deliberately unsigned DX12 .mgfx with DxilContainerHash
         and proves real D3D12 accepts it (and rejects the zero-hash original). -->
    <InternalsVisibleTo Include="ManagedDxilDx12" />
    <InternalsVisibleTo Include="VsDrivenDx12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShadowDusk.Core\ShadowDusk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Issue #282: the build-time Vortice.Dxc version check (warning SD0220). buildTransitive,
         so it also runs for consumers of ShadowDusk.Compiler / ShadowDusk.ContentPipeline. -->
    <None Include="buildTransitive\ShadowDusk.HLSL.targets" Pack="true" PackagePath="buildTransitive\ShadowDusk.HLSL.targets" />
  </ItemGroup>

  <!-- Vortice.Dxc is the ONLY Vortice package on the DXC path. Vortice.Direct3D12 used to ride
       along solely for the managed ID3D12ShaderReflection wrapper types; it was dropped in
       Phase 63 (issue #203) because it carries one type the CLR cannot load
       (VersionedDeviceRemovedExtendedData+Union) and MonoGame 3.8.5's Content Builder scans a
       consumer's whole dependency graph with an unguarded Assembly.GetTypes(). The reflection
       interfaces are now ShadowDusk-owned declarations over SharpGen.Runtime
       (Reflection/Interop/). Do NOT add Vortice.Direct3D12 or Vortice.DXGI back:
       DependencyGraphScanTests reproduces the Builder's scan and fails if any shipped
       dependency stops being GetTypes()-clean. -->
  <ItemGroup>
    <!-- The managed COM wrapper only (Phase 70, issue #287). ExcludeAssets="native" keeps Vortice's
         own DXC 1.7 natives out of this project and, through the packed nuspec's exclude, out of
         every consumer: they would collide by file name with the pinned DXC below, and a
         RID-specific publish resolves such a collision per file. -->
    <PackageReference Include="Vortice.Dxc" ExcludeAssets="native" />
  </ItemGroup>

  <!-- DXBC oracle backend (Phase 18). Vortice.D3DCompiler P/Invokes d3dcompiler_47.dll
       and is Windows-only at RUNTIME; the managed wrappers restore on every OS so the
       cross-platform build stays green. All usage is guarded by OperatingSystem.IsWindows().
       (Vortice.Direct3D11 — ID3D11ShaderReflection — was dropped in Phase 18 Track A:
       DXBC reflection is now the pure-managed RdefReader in ShadowDusk.Core; the
       D3DReflect oracle lives only in ShadowDusk.HLSL.Tests.) -->
  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" />
  </ItemGroup>

  <!-- Cross-platform SM1–5 backend (Phase 18 Track A / Phase 39 FNA): the vkd3d-shader
       native lib. It is a RESTORED artifact (tools/restore.ps1), NOT checked into the
       repo, so every entry is conditional on the file existing — a clean build with no
       restored binary stays green, and Vkd3dShaderCompiler fails loudly (SD0211) at
       runtime if the lib is absent.

       Each restored per-RID binary is BOTH copied to build output (repo/dev runs; the
       Vkd3dLoader base-directory probe) AND packed into the NuGet under
       runtimes/<rid>/native (self-contained consumers; the loader's
       NATIVE_DLL_SEARCH_DIRECTORIES probe). Packing is restore-state-dependent by
       design: the release pipeline must restore every shipping RID before `dotnet pack`
       — see RELEASING.md and plan/PHASE-37 (C). The two macOS dylibs share one file
       name, so their build-output copies keep the per-arch osx-{x64,arm64}/ subdirs
       (Link) — flat links would collide when both are restored on one machine (the
       release pack runner); Vkd3dLoader/FnaTestGate probe the current process arch's
       subdir first, then flat. -->
  <ItemGroup>
    <!-- LGPL-2.1 notice for the bundled vkd3d-shader binaries (Phase 37 C):
         attribution, source availability (the pinned WineHQ tarball + our public
         build recipes), and the full license text ride inside the package. -->
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="THIRD-PARTY-NOTICES.txt" />
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\vkd3d\libvkd3d-shader-1.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\vkd3d\libvkd3d-shader-1.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="libvkd3d-shader-1.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/libvkd3d-shader-1.dll" />
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\vkd3d\libvkd3d-shader.so.1"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\vkd3d\libvkd3d-shader.so.1')"
          CopyToOutputDirectory="PreserveNewest" Link="libvkd3d-shader.so.1"
          Pack="true" PackagePath="runtimes/linux-x64/native/libvkd3d-shader.so.1" />
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\vkd3d\osx-x64\libvkd3d-shader.1.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\vkd3d\osx-x64\libvkd3d-shader.1.dylib')"
          CopyToOutputDirectory="PreserveNewest" Link="osx-x64\libvkd3d-shader.1.dylib"
          Pack="true" PackagePath="runtimes/osx-x64/native/libvkd3d-shader.1.dylib" />
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\vkd3d\osx-arm64\libvkd3d-shader.1.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\vkd3d\osx-arm64\libvkd3d-shader.1.dylib')"
          CopyToOutputDirectory="PreserveNewest" Link="osx-arm64\libvkd3d-shader.1.dylib"
          Pack="true" PackagePath="runtimes/osx-arm64/native/libvkd3d-shader.1.dylib" />
  </ItemGroup>

  <!-- The pinned desktop DXC, v1.9.2607 (0d3ee6b55): the DXC MonoGame 3.8.6 bundles (Phase 70,
       issue #287). No Vortice.Dxc release ships this version.
         win-x64, win-arm64  OUR builds of the tag (.github/workflows/dxc-build.yml), restored into
                             tools/dxc/<rid> by tools/restore.*, Exists-gated like the other
                             restored natives. Microsoft's own Windows binaries are NOT used: that
                             release carries LICENSE-MS.txt (owner decision, project_decisions.md),
                             and its arm64 DLLs are ARM64EC, which an arm64 process cannot load.
         linux-x64, macOS    MonoGame.Tool.Dxc 1.9.2607.1, by PackageDownload (not a dependency):
                             the files mgfxc runs there, built from the same tag.
       DxcNativeIdentity pins each file's stamped build identity. The macOS file is universal and
       is placed once per RID, keeping the per-arch layout DxcLoader and single-file publish use.
       Directory.Build.targets keeps these NuGet-cache files out of browser output by package name. -->
  <ItemGroup Label="Pinned DXC natives">
    <PackageDownload Include="MonoGame.Tool.Dxc" Version="[1.9.2607.1]" />
  </ItemGroup>
  <PropertyGroup Condition="'$(NuGetPackageRoot)' != ''">
    <_PinnedDxcMonoGame>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))monogame.tool.dxc/1.9.2607.1/binaries/</_PinnedDxcMonoGame>
  </PropertyGroup>
  <ItemGroup Condition="'$(_PinnedDxcMonoGame)' != ''">
    <None Include="$(_PinnedDxcMonoGame)linux-x64/lib/libdxcompiler.so" CopyToOutputDirectory="PreserveNewest"
          Link="runtimes/linux-x64/native/libdxcompiler.so" Pack="true" PackagePath="runtimes/linux-x64/native/libdxcompiler.so" />
    <None Include="$(_PinnedDxcMonoGame)osx/lib/libdxcompiler.dylib" CopyToOutputDirectory="PreserveNewest"
          Link="osx-x64/libdxcompiler.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/libdxcompiler.dylib" />
    <None Include="$(_PinnedDxcMonoGame)osx/lib/libdxcompiler.dylib" CopyToOutputDirectory="PreserveNewest"
          Link="osx-arm64/libdxcompiler.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/libdxcompiler.dylib" />
  </ItemGroup>
  <ItemGroup>
    <None Include="licenses\dxc\*" Pack="true" PackagePath="licenses/dxc/" />
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\dxc\win-x64\dxcompiler.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\dxc\win-x64\dxcompiler.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="runtimes/win-x64/native/dxcompiler.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/dxcompiler.dll" />
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\dxc\win-x64\dxil.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\dxc\win-x64\dxil.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="runtimes/win-x64/native/dxil.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/dxil.dll" />
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\dxc\win-arm64\dxcompiler.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\dxc\win-arm64\dxcompiler.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="runtimes/win-arm64/native/dxcompiler.dll"
          Pack="true" PackagePath="runtimes/win-arm64/native/dxcompiler.dll" />
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\dxc\win-arm64\dxil.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\dxc\win-arm64\dxil.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="runtimes/win-arm64/native/dxil.dll"
          Pack="true" PackagePath="runtimes/win-arm64/native/dxil.dll" />
  </ItemGroup>

  <!-- Android DXC native (Phase 50): Vortice.Dxc has no android RID, so for an on-device
       Android compile we bundle OUR OWN libdxcompiler.so built for arm64-v8a from the exact
       pinned DXC commit (0d3ee6b5, the same compiler every other RID runs, never a
       substitute), via the NDK port of the .wasm-build cross-compile recipe. A RESTORED
       artifact (tools/restore.*), Exists()-gated like the macOS/vkd3d entries above: inert
       until the hosted NDK build lands, then packed under runtimes/android-arm64/native so
       .NET-for-Android places it in the APK's lib/arm64-v8a/. DxcLoader resolves it by bare
       SONAME from there (Android W^X-safe). -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\dxc\android-arm64\libdxcompiler.so"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\dxc\android-arm64\libdxcompiler.so')"
          CopyToOutputDirectory="PreserveNewest" Link="android-arm64\libdxcompiler.so"
          Pack="true" PackagePath="runtimes/android-arm64/native/libdxcompiler.so" />
  </ItemGroup>
</Project>
