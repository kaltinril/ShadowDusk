<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Clears the single-TFM default from Directory.Build.props: when TargetFramework is
         non-empty MSBuild single-targets and ignores TargetFrameworks entirely. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ShadowDusk.Metal</AssemblyName>
    <RootNamespace>ShadowDusk.Metal</RootNamespace>
    <!-- Stub project (MslEmitter is empty) — never packed until the Metal backend
         is actually implemented (Phase 31). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShadowDusk.Core\ShadowDusk.Core.csproj" />
  </ItemGroup>
</Project>
